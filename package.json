{
  "name": "tasks-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:up": "sudo docker compose up -d --wait",
    "db:down": "sudo docker compose down -v",
    "db:reset": "pnpm db:down && pnpm db:up",
    "db:logs": "sudo docker compose logs -f db",
    "db:psql": "sudo docker compose exec db sh -c 'psql -U $POSTGRES_USER -d $POSTGRES_DB'"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "dotenv": "^18.0.5",
    "dotenv-expand": "^1000.0.0",
    "hono": "^4.13.12",
    "hono-pino": "^0.10.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
